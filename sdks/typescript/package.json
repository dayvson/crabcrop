{
  "description": "Build and sign crabcrop image URLs",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "license": "MIT",
  "name": "@crabcrop/url",
  "keywords": ["image", "url", "signing", "hmac", "cdn", "crabcrop"],
