    "test": "node --test"
  },
  "type": "module",
  "version": "0.8.0",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^5.9.3"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts"
