{
  "description": "Build and sign crabcrop image URLs",
  "engines": {
    "node": ">=22"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "license": "MIT",
  "name": "@crabcrop/url",
  "keywords": ["image", "url", "signing", "hmac", "cdn", "crabcrop"],
  "files": ["dist"],
  "imports": {
    "#crypto": {
      "browser": "./dist/crypto/portable.js",
      "node": "./dist/crypto/node.js",
      "default": "./dist/crypto/portable.js"
    }
  },
  "publishConfig": { "access": "public" },
  "repository": { "type": "git", "url": "git+https://github.com/dayvson/crabcrop.git", "directory": "sdks/typescript" },
  "scripts": {
    "build": "tsc && tsc -p tsconfig.browser.json",
    "prepack": "npm run build",
    "pretest": "npm run build && tsc -p tsconfig.test.json",
    "test": "node --test && node --conditions=browser --test"
  },
  "type": "module",
  "version": "0.9.11",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts"
}
