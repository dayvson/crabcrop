{
  "bin": {
    "crabcrop-mcp": "dist/index.js"
  },
  "dependencies": {
    "@crabcrop/url": "file:../typescript"
  },
  "description": "First-party MCP server for crabcrop: sign, explain, fetch meta, purge",
  "license": "MIT",
  "name": "@crabcrop/mcp",
  "scripts": {
    "build": "tsc",
    "prepack": "npm --prefix ../typescript run build && npm run build",
    "start": "node src/index.ts",
    "test": "node --test test/*.test.mjs"
  },
  "type": "module",
  "version": "0.9.2",
  "devDependencies": {
    "@types/node": "^26.6.5",
    "typescript": "^5.9.3"
  },
  "main": "./dist/index.js",
  "bundleDependencies": [
    "@crabcrop/url"
  ],
  "mcpName": "io.github.crabcrop/crabcrop",
  "files": [
    "dist",
    "server.json"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dayvson/crabcrop.git",
    "directory": "sdks/mcp"
  },
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=22"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "image",
    "cdn",
    "crabcrop"
  ]
}
