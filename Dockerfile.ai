# crabcrop with AI background removal.
#
# The base image carries no AI payload. This variant layers
# the ONNX Runtime and the segmentation model onto it and
# enables the `removebg` filter by configuration: the model
# is preloaded at boot, so a broken payload fails the
# container at startup, not at first use.
#
# All downloads are checksum-pinned and verified before use
# (audit PL-13): the ONNX Runtime tarball hash is checked
# before extraction and the extracted library again after,
# per architecture; the models are pinned at the ADD. The
# model is a deployment artifact: it is never committed to
# this repo.
#
# The base is an explicit build argument so a build cannot
# silently layer onto a stale local image: pass a digest for
# anything beyond local use, e.g.
#   --build-arg BASE_IMAGE=crabcrop@sha256:<digest>
ARG BASE_IMAGE=crabcrop:latest

# ONNX Runtime is downloaded and checked in a stage of its
# own, so the runtime image needs no curl. The stage runs on
# the build host's platform and fetches the target's
# tarball. Its base is pinned like the runtime images'.
FROM --platform=$BUILDPLATFORM debian:trixie-slim@sha256:62bd423aeee912639ca8ee681c2b762cb3e25137e0a92b20be455898a9f034ad AS onnxruntime
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl \
    && rm -rf /var/lib/apt/lists/*

# ONNX Runtime publishes per-architecture tarballs; pick the
# one matching the target platform and verify both hashes.
ARG TARGETARCH
RUN set -eu; \
    case "$TARGETARCH" in \
      amd64) ort_arch=x64; \
             tgz_sha=cc5c72baf5ae5c8238a6841f0897227be2d02826b9cf98eaf02fdefaeeb03a57; \
             so_sha=469849977cb60744ea160927e1a3a0643fd4c55c0aff743251c6d293402e334e ;; \
      arm64) ort_arch=aarch64; \
             tgz_sha=c5b8b3cca31f3d643a3b313b8f42e2d0f16a4fcefd02cda343d97bd5306afaab; \
             so_sha=595c7f7a6775f5c7b3d567c3ed94c04f722092575abcc092560f5208a54daf99 ;; \
      *) echo "unsupported TARGETARCH: $TARGETARCH" >&2; exit 1 ;; \
    esac; \
    curl -fsSL "https://github.com/microsoft/onnxruntime/releases/download/v1.31.0/onnxruntime-linux-${ort_arch}-1.31.0.tgz" -o /tmp/ort.tgz; \
    echo "$tgz_sha  /tmp/ort.tgz" | sha256sum -c -; \
    tar -xzf /tmp/ort.tgz -C /tmp; \
    mkdir -p /opt/onnxruntime; \
    cp "/tmp/onnxruntime-linux-${ort_arch}-1.31.0/lib/libonnxruntime.so.1.31.0" /opt/onnxruntime/libonnxruntime.so; \
    echo "$so_sha  /opt/onnxruntime/libonnxruntime.so" | sha256sum -c -; \
    rm -rf /tmp/ort.tgz "/tmp/onnxruntime-linux-${ort_arch}-1.31.0"

FROM ${BASE_IMAGE}

# The base image runs as 65534; the steps below set the
# models' mode and need root. The runtime user is restored
# at the end of this file.
USER root

COPY --from=onnxruntime /opt/onnxruntime /opt/onnxruntime

ADD --checksum=sha256:309c8469258dda742793dce0ebea8e6dd393174f89934733ecc8b14c76f4ddd8 https://github.com/danielgatis/rembg/releases/download/v0.0.0/u2netp.onnx /models/u2netp.onnx

ADD --checksum=sha256:8f2383e4dd3cfbb4553ea8718107fc0423210dc964f9f4280604804ed2552fa4 https://github.com/opencv/opencv_zoo/raw/main/models/face_detection_yunet/face_detection_yunet_2023mar.onnx /models/yunet.onnx

# Remote ADD files land mode 0600; the runtime user (65534)
# must be able to read the models at boot preload.
RUN chmod 644 /models/u2netp.onnx /models/yunet.onnx

# The upscale model follows the same rule (layered artifact,
# preloaded at boot). Super-resolution ONNX exports are less
# standardized than u2netp, so the operator layers their own:
# COPY my-sr-model.onnx /models/sr.onnx
# ENV CRABCROP_UPSCALE_MODEL=/models/sr.onnx

# ONNX Runtime telemetry off unless an operator opts in.
ENV ORT_DISABLE_TELEMETRY=1 \
    CRABCROP_ORT_DYLIB=/opt/onnxruntime/libonnxruntime.so \
    CRABCROP_REMOVEBG_MODEL=/models/u2netp.onnx \
    CRABCROP_FACE_MODEL=/models/yunet.onnx

# Restore the base image's runtime user, by number.
USER 65534:65534
