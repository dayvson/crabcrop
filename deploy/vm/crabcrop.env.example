# crabcrop environment file. Copy to /etc/crabcrop/crabcrop.env,
# keep it root-only (mode 0600): it holds the signing secret.

# The signing secret: at least 16 bytes, required. Generate one:
#   openssl rand -hex 32
CRABCROP_SECRET=replace-with-a-long-random-value

# Listen port (default 3000). The reverse proxy is the public
# face; keep this port off the public internet: /health is
# unauthenticated and /metrics exposes traffic and error
# counters.
PORT=3000

# Disk result tier. The unit creates this directory through
# its CacheDirectory setting.
CRABCROP_RESULT_STORAGE_DIR=/var/cache/crabcrop

# Any other variable from the main README's Configuration
# table can go in this file, one per line.
