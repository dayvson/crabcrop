# crabcrop environment file. Copy to /etc/crabcrop/crabcrop.env,
# keep it root-only (mode 0600): it holds the signing secret.

# The signing secret: at least 16 bytes, required. The
# server refuses to start until REPLACE_ME is replaced.
# Generate one:
#   openssl rand -hex 32
CRABCROP_SECRET=REPLACE_ME

# Listen address and port (default every IPv4 interface,
# port 3000). The reverse proxy on this host is the public face,
# so the server listens on localhost only: /health is
# unauthenticated, and a client that reached the port
# directly would skip the proxy's TLS and limits. /metrics
# answers 403 while CRABCROP_METRICS_TOKEN is unset, and 401
# without the right bearer token once it is set.
CRABCROP_BIND=127.0.0.1
PORT=3000

# Disk result tier. The unit creates this directory through
# its CacheDirectory setting.
CRABCROP_RESULT_STORAGE_DIR=/var/cache/crabcrop

# Any other variable from docs/configuration.md can go in
# this file, one per line.
