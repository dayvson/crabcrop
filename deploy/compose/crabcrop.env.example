# crabcrop production environment. Copy to crabcrop.env in
# this directory, fill in the two values marked below, and
# keep the copy owner-only (chmod 600): it holds the signing
# secret. crabcrop.env is git-ignored; this example is the
# only version that belongs in the repo.
#
#   cp crabcrop.env.example crabcrop.env
#   chmod 600 crabcrop.env

# The signing secret: at least 16 bytes, required. The
# server refuses to start without it. Generate one:
#   openssl rand -hex 32
# SET THIS:
CRABCROP_SECRET=<redacted>

# Bearer <redacted> for GET /metrics. Without one, /metrics
# answers 403 to everyone; with one, a request must carry
# Authorization: Bearer <token> or it answers 401.
# SET THIS (a different value from the secret):
CRABCROP_METRICS_TOKEN=CHANGE-ME-generate-with-openssl-rand-hex-32

# The public host name is not in this file: it is public
# configuration, set in the compose environment when you
# start the production run (see the README). The signing
# secret above does not belong in the proxy's environment,
# and the name does not belong in the secrets file.

# Listen port inside the container network. Only Caddy
# talks to it; it is not published on the host.
PORT=3000

# Memory result tier. The production compose file limits
# the container to 2 CPUs and 2 GB; 512 MB of cache leaves
# the rest for decode and encode working set.
CRABCROP_CACHE_MAX_MB=512

# Disk result tier budget. The directory itself is set by
# the production compose file (a named volume); renders
# survive container restarts and rebuilds.
CRABCROP_RESULT_STORAGE_MAX_MB=8192

# One long-running render at a time (animated encodes,
# video, PDF pages) on permits stills never use, so a
# saturated slow lane cannot slow a still. Raise on hosts
# with cores to spare for animation or video traffic.
CRABCROP_SLOW_LANE_PERMITS=1

# Hard wall-clock limit on processing one request.
CRABCROP_PROCESS_TIMEOUT_SECS=30

# Refuse sources that resolve to non-public addresses.
CRABCROP_BLOCK_PRIVATE_SOURCES=1

# Any other variable from the main README's Configuration
# table can go in this file, one per line.
