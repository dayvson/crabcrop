# crabcrop configuration used by the benchmark.
# The harness exports these variables when it starts the server;
# this file records them in one place. Everything else is the
# server default, including the in-memory result cache.
CRABCROP_SECRET=bench-secret-0123456789
CRABCROP_ALLOW_UNSAFE=1
CRABCROP_ALLOWED_SOURCES=127.0.0.1
PORT=3310
