# imgproxy configuration used by the benchmark.
# Production oriented, following the imgproxy configuration docs:
# one worker per available core is the documented sizing guidance
# (IMGPROXY_WORKERS defaults to the number of CPU cores when unset;
# it is set explicitly here so the run is reproducible on paper).
# No IMGPROXY_KEY or IMGPROXY_SALT: signature checking is disabled,
# matching the unsafe mode used for the other two systems.
IMGPROXY_BIND=127.0.0.1:8080
IMGPROXY_WORKERS=4
# Benchmark only: the origin is a local server on 127.0.0.1, and
# imgproxy refuses loopback sources by default. A production
# deployment serving local origins would need the same setting;
# it does not change processing, only source fetching policy.
IMGPROXY_ALLOW_LOOPBACK_SOURCE_ADDRESSES=true
IMGPROXY_MAX_CLIENTS=100
IMGPROXY_TTL=31536000
VIPS_WARNING=0
MALLOC_ARENA_MAX=2
